# Copy this file to `.env` and adjust the values. `.env` is git-ignored.
# These are demo values — do not use real secrets in this project.

POSTGRES_DB=corp_gift
POSTGRES_USER=corp_gift
POSTGRES_PASSWORD=change-me

# Used by the application container to reach the database by service name.
DATABASE_URL=postgresql://corp_gift:change-me@db:5432/corp_gift

# Google OAuth 2.0 credentials of the identity provider.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Secret used to sign the session cookie. Generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Secret used to sign the registration ticket; must differ from NEXTAUTH_SECRET.
REGISTRATION_TICKET_SECRET=replace-with-a-long-random-registration-secret

# Public address users actually reach; it must match the Google redirect URI.
NEXTAUTH_URL=https://replace-with-your-public-host
